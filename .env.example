# このファイルをコピーして .env.local を作り、値を埋める (.env.local は gitignore 済み)。
#   cp .env.example .env.local

# 書き込み先スプレッドシート ID (URL の /d/ と /edit の間)。既定はコード内の値。
SPREADSHEET_ID=1Zivd5Dorzc_fnwYF0gt5QSliq1MwLs6ZntNmt3AyeD4

# 取得する日次データ本数 (RSI300/MA200 を埋めるため 800 本程度を推奨)。
HISTORY_DAYS=800

# --- 認証 (いずれか一方) ---
# (A) サービスアカウント鍵ファイルのパス
# GOOGLE_APPLICATION_CREDENTIALS=./service_account.json

# (B) サービスアカウント鍵 JSON の中身を直接 (CI 向け。改行なしの 1 行 JSON)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
