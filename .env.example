# このファイルをコピーして .env.local を作り、値を埋める (.env.local は gitignore 済み)。
#   cp .env.example .env.local

# 書き込み先スプレッドシート ID (URL の /d/ と /edit の間)。既定はコード内の値。
SPREADSHEET_ID=1Zivd5Dorzc_fnwYF0gt5QSliq1MwLs6ZntNmt3AyeD4

# 取得する日次データ本数 (RSI300/MA200 を埋めるため 800 本程度を推奨)。
HISTORY_DAYS=800

# --- Google 認証 (いずれか一方) ---
# (A) サービスアカウント鍵ファイルのパス
# GOOGLE_APPLICATION_CREDENTIALS=./service_account.json

# (B) サービスアカウント鍵 JSON の中身を直接 (CI 向け。改行なしの 1 行 JSON)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# --- J-Quants 認証 (いずれか) ---
# (A) リフレッシュトークン (1週間有効・推奨)。Web マイページのボタンで取得。
# JQUANTS_REFRESH_TOKEN=xxxxx
# (B) IDトークンを直接 (24時間有効)
# JQUANTS_ID_TOKEN=xxxxx
# (C) メール/パスワード (Google 連携アカウントは不可)
# JQUANTS_MAILADDRESS=you@example.com
# JQUANTS_PASSWORD=xxxxx
